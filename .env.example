# Copy to .env and edit. Everything here is optional.

# Web server
TSIM_HOST=127.0.0.1
TSIM_PORT=8000

# API key that external bots must send as header  X-API-Key  (leave empty to allow any local client)
TSIM_API_KEY=

# Databento (historical CME data import). Get a key at databento.com (new accounts get free credit).
DATABENTO_API_KEY=

# Interactive Brokers (live CME top-of-book data through TWS / IB Gateway)
IBKR_HOST=127.0.0.1
IBKR_PORT=7497
IBKR_CLIENT_ID=17
